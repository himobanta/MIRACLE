# Backend environment configuration for Miracle
# Copy this file to .env and set real values before starting the backend.
# NEVER commit the filled .env file to version control.

# ── Environment ───────────────────────────────────────────────────────────────
# Options: development | staging | stage | production | prod
ENVIRONMENT=development

# ── JWT Secret ────────────────────────────────────────────────────────────────
# REQUIRED in staging/production. Generate: openssl rand -hex 32
# Development falls back to an insecure default if unset.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# ── Database ──────────────────────────────────────────────────────────────────
# Development default: SQLite (file-based, no setup required)
# Staging/Production REQUIRED: PostgreSQL connection string
DATABASE_URL=sqlite:///./miracle.db
# DATABASE_URL=postgresql://miracle_user:your_password@localhost:5432/miracle_staging

# ── CORS Origins ──────────────────────────────────────────────────────────────
# REQUIRED in staging/production. Comma-separated allowed frontend origins.
# Development default allows localhost Vite dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGINS=https://staging.miracleskincare.com

# ── Password Hashing ──────────────────────────────────────────────────────────
PASSWORD_HASHING_SCHEME=argon2id

# ── Auth Rate Limiting ────────────────────────────────────────────────────────
AUTH_RATE_LIMIT_LOGIN=100/minute
AUTH_RATE_LIMIT_REGISTER=50/minute

# ── PostgreSQL Connection Pooling (used only when DATABASE_URL is PostgreSQL) ─
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
