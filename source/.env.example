# Frontend environment configuration for Miracle
# Copy this file to .env and set real values before running the Vite build.
# NEVER commit the filled .env file to version control.
#
# VITE_API_URL is injected at build time by Vite into the JS bundle.
# Set it to the full backend API base URL for your environment.

# ── Development (local backend) ───────────────────────────────────────────────
VITE_API_URL=http://127.0.0.1:8000/api/v1

# ── Staging (uncomment and replace with your staging API domain) ──────────────
# VITE_API_URL=https://staging-api.miracleskincare.com/api/v1

# ── Production (uncomment and replace with your production API domain) ─────────
# VITE_API_URL=https://api.miracleskincare.com/api/v1
