# ==============================================================================
# MIRACLE — Production & Staging Environment Variables Example
# NEVER commit real credentials, passwords, or secrets to Git.
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# BACKEND ENVIRONMENT VARIABLES (Render Web Service)
# ──────────────────────────────────────────────────────────────────────────────

# Environment mode (options: production | staging | development)
ENVIRONMENT=production

# Python module path resolution
PYTHONPATH=.

# Python version for Render runtime
PYTHON_VERSION=3.11.9

# JWT Secret: Cryptographically random string (≥ 32 chars).
# Generate via: openssl rand -hex 32
JWT_SECRET=your_long_random_jwt_secret_at_least_32_characters_here

# PostgreSQL Database Connection String:
# e.g., postgresql://username:password@hostname:5432/database_name
# (Preserve your existing Railway PostgreSQL URL or use Render PostgreSQL)
DATABASE_URL=postgresql://postgres:password@host:5432/miracle_db

# CORS Allowed Origins:
# Comma-separated list of allowed frontend domains.
# Must include your Render Frontend domain.
# e.g., https://miracle-frontend.onrender.com,http://localhost:5173
CORS_ORIGINS=https://miracle-frontend.onrender.com,http://localhost:5173

# Password Hashing Algorithm (default: argon2id)
PASSWORD_HASHING_SCHEME=argon2id

# Database Connection Pool Settings (for PostgreSQL)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800


# ──────────────────────────────────────────────────────────────────────────────
# FRONTEND ENVIRONMENT VARIABLES (Render Static Site — Build Time)
# ──────────────────────────────────────────────────────────────────────────────
# NOTE: Variables prefixed with VITE_ are embedded into public client bundles.
# NEVER put passwords, API private keys, or JWT secrets in VITE_ variables.

# Backend API Endpoint URL (must include /api/v1):
# e.g., https://miracle-backend.onrender.com/api/v1
VITE_API_URL=https://miracle-backend.onrender.com/api/v1
